<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane prefHeight="266.0" prefWidth="363.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pucgoias.aulasjavafx.HelloController">
   <children>
      <Label fx:id="labelMensagem" alignment="CENTER" layoutX="104.0" layoutY="180.0" prefHeight="63.0" prefWidth="156.0" text="Teste" textAlignment="CENTER" wrapText="true" />
      <VBox alignment="CENTER" layoutX="99.0" layoutY="52.0" spacing="20">
      
          <Button fx:id="btnUm" onAction="#botaoUmClicado" text="Botão 1 (Tratador externo)" />
          <Button fx:id="btnDois" onAction="#botaoDoisClicado" text="Botão 2 (Expressão Lambda)" />
          <Button fx:id="btnTres" onAction="#botaoTresClicado" text="Botão 3 (Própria classe)" />
      
      </VBox>
   </children>
</Pane>
